config_file_profile   = "DEFAULT"
region                = "REGION_NAME"
tenancy_ocid          = "TENANCY_OCID"
compartment_ocid      = "COMPARTMENT_OCID"
subscription_email    = "SUBSCRIPTION_EMAIL"
github_token          = "GITHUB_TOKEN"

# Model AI is intentionally opt-in because GPU/Data Science resources are bill-impacting.
model_ai_enabled      = false
model_ai_shape        = "VM.GPU.A10.1"

# Secure OCI A10 Ollama path. Keep the host private to the worker subnet.
model_ollama_enabled         = false
model_ollama_shape           = "VM.GPU.A10.1"
model_ollama_ocpus           = 0
model_ollama_memory_in_gbs   = 0
model_ollama_image_ocid      = ""
model_ollama_model_id        = "llama3.1:8b"
model_ollama_custom_model_id = "llama3.1:8b-stwl"
model_ollama_adapter_uri     = ""

# Wire these to output model_ollama_chat_url after enabling model_ollama_enabled.
model_ai_base_upstream_format = "ollama"
model_ai_ft_upstream_format   = "ollama"
