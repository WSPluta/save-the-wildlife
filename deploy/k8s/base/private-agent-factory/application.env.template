PORT=8080
NODE_ENV=production

# Oracle Private Agent Factory agent configuration for Save the Wildlife.
PAF_AGENT_NAME=save-the-wildlife-commentator
PAF_AGENT_MODE=moderated
PAF_COMMENTARY_MAX_CHARS=200
PAF_ORACLE_QUERY_TIMEOUT_MS=8000
INDB_AGENT_ENABLED=true
INDB_AGENT_AUTO_INIT=true
INDB_AGENT_PACKAGE=STWL_COMMENTARY_PKG
INDB_AGENT_TIMEOUT_MS=10000
PAF_MATCH_INTELLIGENCE_ENABLED=true
PAF_MATCH_INTELLIGENCE_AUTO_INIT=true
PAF_CONTEXT_TIMEOUT_MS=8000
PAF_CONTEXT_MAX_EVENTS=12
PAF_GRAPH_RETRIEVAL_ENABLED=true
PAF_REPLAY_RETRIEVAL_ENABLED=true
PAF_REPLAY_MAX_CLIPS=3
PAF_VECTOR_RETRIEVAL_ENABLED=true
PAF_VECTOR_TOP_K=3
PAF_AGENT_MEMORY_PERSIST=true

# Model AI router. The endpoint auth token is loaded from the optional
# private-agent-factory-model-auth Kubernetes Secret, not this ConfigMap.
PAF_MODEL_ROUTE_MODE=TEMPLATE_PAF_MODEL_ROUTE_MODE
PAF_PRIMARY_MODEL_PROVIDER=TEMPLATE_PAF_PRIMARY_MODEL_PROVIDER
PAF_CANDIDATE_MODEL_PROVIDER=TEMPLATE_PAF_CANDIDATE_MODEL_PROVIDER
OCI_BASE_MODEL_ENDPOINT_URL=TEMPLATE_OCI_BASE_MODEL_ENDPOINT_URL
OCI_FT_MODEL_ENDPOINT_URL=TEMPLATE_OCI_FT_MODEL_ENDPOINT_URL
OCI_MODEL_ENDPOINT_TIMEOUT_MS=TEMPLATE_OCI_MODEL_ENDPOINT_TIMEOUT_MS
OCI_MODEL_ENDPOINT_VERIFY_TLS=TEMPLATE_OCI_MODEL_ENDPOINT_VERIFY_TLS
PAF_TRACE_PERSIST=TEMPLATE_PAF_TRACE_PERSIST
PAF_EVAL_ENABLED=TEMPLATE_PAF_EVAL_ENABLED
PAF_MODEL_FAST_PATH_ENABLED=TEMPLATE_PAF_MODEL_FAST_PATH_ENABLED
PAF_EVAL_RUBRIC_VERSION=TEMPLATE_PAF_EVAL_RUBRIC_VERSION
PAF_TRAINING_CAPTURE_ENABLED=TEMPLATE_PAF_TRAINING_CAPTURE_ENABLED

# Published Oracle Private Agent Factory Canvas endpoint. The adapter posts
# deterministic SQL telemetry to this Canvas run URL before falling back locally.
PAF_CANVAS_RUN_ENDPOINT_URL=TEMPLATE_PAF_CANVAS_RUN_ENDPOINT_URL
PAF_CANVAS_ROOM_ID=TEMPLATE_PAF_CANVAS_ROOM_ID
PAF_CANVAS_TIMEOUT_MS=TEMPLATE_PAF_CANVAS_TIMEOUT_MS
PAF_COMMENTARY_DEADLINE_MS=TEMPLATE_PAF_COMMENTARY_DEADLINE_MS
PAF_CANVAS_RETURN_RESERVE_MS=TEMPLATE_PAF_CANVAS_RETURN_RESERVE_MS
PAF_CANVAS_MIN_TIMEOUT_MS=TEMPLATE_PAF_CANVAS_MIN_TIMEOUT_MS
PAF_CANVAS_VERIFY_TLS=TEMPLATE_PAF_CANVAS_VERIFY_TLS

# OCI Generative AI access. The pod is intended to use instance principal
# from the OKE worker node unless a concrete PAF image supplies another auth mode.
OCI_AUTH=instance_principal
OCI_REGION=TEMPLATE_OCI_REGION
OCI_COMPARTMENT_OCID=TEMPLATE_COMPARTMENT_OCID
OCI_GENAI_MODEL_ID=TEMPLATE_GENAI_MODEL_ID

# Runtime database contract. The PAF app should read these objects and produce
# bounded commentary from deterministic SQL summaries.
GAME_EVENTS_TABLE=STWL_GAME_EVENTS
GAME_SESSION_SUMMARY_VIEW=STWL_SESSION_SUMMARY
REPLAY_CLIPS_TABLE=STWL_REPLAY_CLIPS
AGENT_MEMORIES_TABLE=STWL_AGENT_MEMORIES
SELECT_AI_AUTO_INIT=true
SELECT_AI_PROFILE=STWL_GAMEPLAY_AI
SELECT_AI_AGENT_TEAM=STWL_GAMEPLAY_COMMENTARY_TEAM
SELECT_AI_REGION=TEMPLATE_OCI_REGION
SELECT_AI_MODEL=TEMPLATE_GENAI_MODEL_ID
SELECT_AI_OCI_APIFORMAT=COHERE

ORACLE_USER=ADMIN
ORACLE_PASSWORD=TEMPLATE_ADB_PASSWORD
ORACLE_CONNECT_STRING=TEMPLATE_ADB_SERVICE_high
ORACLE_CONFIG_DIR=/wallet
ORACLE_WALLET_PASSWORD=TEMPLATE_ADB_WALLET_PASSWORD
TNS_ADMIN=/wallet
