PORT=8080
NODE_ENV=production

# Oracle Private Agent Factory agent configuration for Save the Wildlife.
PAF_AGENT_NAME=save-the-wildlife-commentator
PAF_AGENT_MODE=moderated
PAF_COMMENTARY_MAX_CHARS=200
PAF_ORACLE_QUERY_TIMEOUT_MS=2000

# Published Oracle Private Agent Factory Canvas endpoint. The adapter posts
# deterministic SQL telemetry to this Canvas run URL before falling back locally.
PAF_CANVAS_RUN_ENDPOINT_URL=TEMPLATE_PAF_CANVAS_RUN_ENDPOINT_URL
PAF_CANVAS_ROOM_ID=TEMPLATE_PAF_CANVAS_ROOM_ID
PAF_CANVAS_TIMEOUT_MS=TEMPLATE_PAF_CANVAS_TIMEOUT_MS
PAF_CANVAS_VERIFY_TLS=TEMPLATE_PAF_CANVAS_VERIFY_TLS

# OCI Generative AI access. The pod is intended to use instance principal
# from the OKE worker node unless a concrete PAF image supplies another auth mode.
OCI_AUTH=instance_principal
OCI_REGION=TEMPLATE_OCI_REGION
OCI_COMPARTMENT_OCID=TEMPLATE_COMPARTMENT_OCID
OCI_GENAI_MODEL_ID=TEMPLATE_GENAI_MODEL_ID

# Runtime database contract. The PAF app should read these objects and produce
# bounded commentary from deterministic SQL summaries.
GAME_EVENTS_TABLE=STWL_GAME_EVENTS
GAME_SESSION_SUMMARY_VIEW=STWL_SESSION_SUMMARY
SELECT_AI_PROFILE=STWL_GAMEPLAY_AI

ORACLE_USER=ADMIN
ORACLE_PASSWORD=TEMPLATE_ADB_PASSWORD
ORACLE_CONNECT_STRING=TEMPLATE_ADB_SERVICE_high
ORACLE_CONFIG_DIR=/wallet
ORACLE_WALLET_PASSWORD=TEMPLATE_ADB_WALLET_PASSWORD
TNS_ADMIN=/wallet
