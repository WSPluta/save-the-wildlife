PORT=3000
BROADCAST_REFRESH_UPDATE=50

ENABLE_COHERENCE_BACKEND=true

ENABLE_REDIS_BACKEND=true
REDIS_PASSWORD=MASTERPASSWORD

CLEANUP_STALE_IN_SECONDS=2
BROADCAST_ITEMS_IN_SECONDS=2

ITEM_MAX_SIZE=0.9
ITEM_MIN_SIZE=0.5

WORLD_SIZE_X=88
WORLD_SIZE_Z=22

GAME_DURATION_IN_SECONDS=180

# Physics tuning
PHYS_ACCELERATION=6
PHYS_BRAKE=3
PHYS_MAX_SPEED=3
PHYS_FRICTION=1.5
PHYS_TURN_SPEED=0.523599
PHYS_DRIFT=0

# Server authority
SERVER_AUTH_ENABLED=true
SIM_TPS=60
STATE_BROADCAST_HZ=20
COLLISION_VALIDATE_RADIUS=1.0

# Power-ups
POWERUP_SPEED_MULTIPLIER=2
POWERUP_SPEED_DURATION_MS=10000
POWERUP_SHIELD_DURATION_MS=5000

# Internal Score service (avoid hairpin through Ingress)
SCORE_SERVICE_HOST=score
SCORE_SERVICE_PORT=8080

# Disable local replay fallback (use Replay service via ClusterIP/Ingress)
ENABLE_REPLAY_FALLBACK=false
