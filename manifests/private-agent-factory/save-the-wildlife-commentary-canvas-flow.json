            "type": "flowGenericNode",
      "position": {
        "x": -40,
        "y": 220
      },
      "data": {
        "title": "Save the Wildlife commentary prompt",
        "type": "promptComponent",
        "description": "Constrain the commentator to recorded Oracle SQL gameplay telemetry.",
        "icon": "terminal",
        "fieldOrder": [
          "prompt"
        ],
        "dynamicFields": {
          "prompt": [
            "user_input"
          ]
        },
        "passInlineData": false,
        "template": {
          "prompt": {
            "componentType": "textAreaFormat",
            "componentProps": {
              "label": "Template",
              "placeholder": ""
            },
            "required": true,
            "valueType": "str",
            "value": "You are the Save the Wildlife conference commentator running inside Oracle Private Agent Factory Canvas.\n\nRules:\n- Use only the Oracle SQL gameplay telemetry supplied below.\n- Return exactly one short commentator line under 200 characters.\n- Mention powerups, trail crossings, player freezes, coordinates, or prior-session history only when the telemetry includes them.\n- Do not invent events, animals, players, locations, scores, or history.\n- No profanity, insults, or unsafe live-demo language.\n- Do not expose SQL, JSON, credentials, internal service names, or implementation details.\n\nGameplay telemetry:\n{{user_input}}"
          },
          "user_input": {
            "componentType": "label",
            "componentProps": {
              "connectionsAllowed": 1,
              "label": "user_input"
            },
            "display": true,
            "dynamic": true,
            "inputTypes": [
              "message"
            ],
            "required": false,
            "value": [],
            "valueType": "str"
          }
        },
        "outputs": [
          {
            "id": "output",
            "label": "Prompt message",
            "outputTypes": [
              "message"
            ]
          }
                ]
            }
        },
